# Copy to `.env` at the project root (gitignored). Required for release builds
# because `.env` is bundled as a Flutter asset in pubspec.yaml.
#
# Values are loaded in main via dotenv.load and can also be passed as
# --dart-define=SUPABASE_URL=... or --dart-define-from-file=env.json for CI.
#
# Production key sources:
#   Supabase  → Project Settings → API
#   Google    → Google Cloud Console → OAuth 2.0 Web client ID
#   RevenueCat → Project → API keys → Public app-specific keys (appl_/goog_)
#
# Supabase: Project Settings → API
SUPABASE_URL=https://izxhqvpkohzvgnzwqjif.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Iml6eGhxdnBrb2h6dmduendxamlmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzU5MjEwNzEsImV4cCI6MjA5MTQ5NzA3MX0.f0twileNkAohMPtBUoFtYgJnwou4M_72JbBPhWMlGxU

# Optional; must match native URL scheme and Supabase Auth redirect allowlist
SUPABASE_OAUTH_REDIRECT=com.buniasoft.simsim://auth-callback

# Native Google Sign-In (Android/iOS): Web application OAuth 2.0 client ID from
# Google Cloud Console — enables ID token exchange with Supabase without the browser.
# Must match Supabase Auth → Providers → Google (Client ID) and Firebase
# google-services.json OAuth client type 3. Register debug + Play App Signing
# SHA-1/256 in Firebase for Android.
GOOGLE_WEB_CLIENT_ID=711732809453-lh7s5q6mpac20lcn1k6k82n0ftgd9g9f.apps.googleusercontent.com
# Optional on iOS if already in GoogleService-Info.plist
GOOGLE_IOS_CLIENT_ID=711732809453-i66vdrien8qofns4unefh2teat2g4p12.apps.googleusercontent.com

# Expiry AI — prefer Google Secret Manager (`simsim-expiry-ai-config`) via
# Edge Function `expiry-ai-config`. Local .env is fallback only.
# Switch model without release: edit scripts/expiry-ai-config.secret.json then
#   ./scripts/expiry-ai-secret.sh set scripts/expiry-ai-config.secret.json
#   ./scripts/expiry-ai-secret.sh mirror   # optional Supabase fallback
EXPIRY_AI_CLOUD_ENABLED=true
EXPIRY_AI_MODEL=gemini-3.7-flash
EXPIRY_AI_DAILY_LIMIT=40
EXPIRY_AI_MAX_IMAGE_BYTES=400000
EXPIRY_AI_CLOUD_ONLY_WHEN_EMPTY=false
EXPIRY_AI_MAX_OUTPUT_TOKENS=384
EXPIRY_AI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_HIGH
EXPIRY_AI_SUPABASE_FALLBACK=false

# Optional: App Check debug tokens (DEBUG only — never ship in release).
# Create/register under Firebase → App Check → Apps → each platform app →
# Manage debug tokens. iOS and Android need separate tokens — never put an
# iOS token in APP_CHECK_DEBUG_TOKEN_ANDROID (Gemini will 403).
# APP_CHECK_DEBUG_TOKEN_IOS=
# APP_CHECK_DEBUG_TOKEN_ANDROID=

# RevenueCat: Project → API keys → Public app-specific keys (NOT the secret key)
# iOS appl_… / Android goog_… for production; test_… for sandbox only.
# Dashboard: two entitlement lookup keys — `standard` (Pro card) and `pro`
# (Business card). Offering `default` must be Current with all four products.
REVENUECAT_IOS_PUBLIC_SDK_KEY=appl_KJxoAiRIujbbzUJhFjfNNOZkOrT
REVENUECAT_ANDROID_PUBLIC_SDK_KEY=goog_rZFycCzoJgJCtlTuiMOaBLrAlRf
